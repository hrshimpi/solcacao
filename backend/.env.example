# The settings of the API. Copy this file to .env and change the values. Never commit the real .env.
# development, test or production
NODE_ENV=development
# The port of the API. In production it listens on 127.0.0.1 only, and Nginx passes the requests to it.
PORT=4000
# The connection string of the database. Local MongoDB for development, the Atlas string in production (put the database name solcacao after the host).
MONGODB_URI=mongodb://127.0.0.1:27017/solcacao
# The secret that signs login tokens. Required in production, at least 32 random characters (node -e "console.log(require('crypto').randomBytes(48).toString('hex'))").
JWT_SECRET=change-me-to-a-long-random-text
# The address of the website, with https and no trailing slash. Several are fine, separated by commas, the first one is used in emails.
# Required in production. In development http://localhost:5173 is always allowed too.
CLIENT_URL=http://localhost:5173
# How many proxies sit between the internet and this server. Left out, it is 1 in production (Nginx) and 0 otherwise.
# TRUST_PROXY=1
# The folder for uploaded files. In production use a folder outside the code folder, so a new copy of the code keeps the files.
UPLOAD_DIR=./uploads
# The largest file in MB and the most files in one upload (Nginx client_max_body_size has to be bigger than files times size).
MAX_UPLOAD_MB=50
MAX_UPLOAD_FILES=5
# Email: smtp sends with the settings below, off only logs one line. Left out, it is off in production and smtp otherwise.
MAIL_MODE=off
# The mail server. Leave SMTP_HOST empty to only log the messages. Use port 587 or 465, never 25 (AWS blocks it).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# The sender, and where the messages for the team go (MAIL_TO_SUPPORT for questions, MAIL_TO_WHOLESALE for quotes and wholesale)
MAIL_FROM="SolCacao <no-reply@solcacao.example>"
MAIL_TO_SUPPORT=support@solcacao.example
MAIL_TO_WHOLESALE=wholesale@solcacao.example
# The first admin, made by pnpm seed. The email must be a real address you can use, the password at least 10 characters with a letter and a number.
ADMIN_EMAIL=
ADMIN_PASSWORD=
LOG_LEVEL=info
# Sign in. The access token works for a few minutes, the refresh cookie for a few days.
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
# Leave these out to use 12 (4 in tests) and true in production (the cookie only travels over https)
# BCRYPT_COST=12
# COOKIE_SECURE=true
# A key for the team's own tools, sent as X-Staff-Key. At least 24 characters, or leave it empty to turn it off.
# STAFF_API_KEY=
# Requests one visitor may send in the window (minutes) and wrong tries on the sign in routes
RATE_LIMIT_MAX=600
RATE_LIMIT_WINDOW_MINUTES=15
AUTH_RATE_LIMIT_MAX=10
