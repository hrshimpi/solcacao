PORT=4000
NODE_ENV=development
# The database and the secret for login tokens (use a long random text for JWT_SECRET)
MONGODB_URI=mongodb://127.0.0.1:27017/solcacao
JWT_SECRET=dev-only-secret-change-me
# Email. Leave SMTP_HOST empty to only log the messages (see the Email section in the README)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="SolCacao <no-reply@solcacao.example>"
MAIL_TO_SUPPORT=support@solcacao.example
MAIL_TO_WHOLESALE=wholesale@solcacao.example
LOG_LEVEL=info
# The address of the website. Only this address may send changes from a browser. Several are fine, separated by commas,
# and the first one is used in emails. In production put the address people really use (for example your Netlify address).
CLIENT_ORIGIN=http://localhost:5173
# How many proxies sit between the internet and this server (0 when none, 1 behind one load balancer). If this is wrong,
# the limits on requests count all visitors together.
TRUST_PROXY=0
# Sign in. The access token works for a few minutes, the refresh cookie for a few days.
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
# Leave these out to use 12 (4 in tests) and true in production (the cookie only travels over https)
# BCRYPT_COST=12
# COOKIE_SECURE=true
# A key for the team's own tools, sent as X-Staff-Key. At least 24 characters, or leave it empty to turn it off.
# STAFF_API_KEY=
# Requests one visitor may send in the window (minutes) and wrong tries on the sign in routes
RATE_LIMIT_MAX=600
RATE_LIMIT_WINDOW_MINUTES=15
AUTH_RATE_LIMIT_MAX=10
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=50
MAX_UPLOAD_FILES=5
