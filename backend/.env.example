PORT=4000
NODE_ENV=development
# The database and the secret for login tokens (use a long random text for JWT_SECRET)
MONGODB_URI=mongodb://127.0.0.1:27017/solcacao
JWT_SECRET=dev-only-secret-change-me
# Email. Leave SMTP_HOST empty to only log the messages (see the Email section in the README)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="SolCacao <no-reply@solcacao.example>"
MAIL_TO_SUPPORT=support@solcacao.example
MAIL_TO_WHOLESALE=wholesale@solcacao.example
LOG_LEVEL=info
CLIENT_ORIGIN=http://localhost:5173
